# dependencies and builds
node_modules/
dist/
# local captures and stray screenshots (regenerated by the lab / devtools sessions)
.art-captures/
pass2-*.png
# one-off backups of the pre-split catalog
.art-assets/food-models.backup.json
# OS
.DS_Store
# temporary uploads made by the lab import dialog (the originals stay where you picked them)
.art-assets/imports/upload_*
# voxel grids are intermediates of an import; the source .glb next to them regenerates them
.art-assets/imports/*.vox.json
# dry-run logs
.art-assets/import-batch.log
# 3D source files stay local only (the converted voxel models are the catalog; originals also live in ~/Downloads)
.art-assets/imports/*.glb
.art-assets/imports/*.gltf
.art-assets/imports/*.obj
